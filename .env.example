# Copy to .env for local runs. On Render, set these in the service's Environment tab.

# --- App access (HTTP Basic auth). Required in production. ---
APP_USER=admin
APP_PASSWORD=

# --- ActiveCampaign (Settings > Developer). Leave blank to run on demo data. ---
AC_API_URL=https://youraccount.api-us1.com
AC_API_KEY=
SITE_DOMAIN=akdaisolutions.com
# Optional filters for "Retrieve all leads" (numeric ids from ActiveCampaign)
AC_LEAD_TAG_ID=
AC_LEAD_LIST_ID=
AC_MAX_LEADS=25
ACTIVITY_WINDOW_DAYS=30
# Opens are not in the v3 activity feed; v1 campaign_report_open_list is used per campaign. v1 | off
AC_OPENS_SOURCE=v1
# Requests per second to ActiveCampaign (account limit is 5)
AC_RPS=4
AC_CACHE_SECONDS=300
# Optional custom field ids for job title / company
AC_FIELD_TITLE_ID=
AC_FIELD_COMPANY_ID=
# Force demo data even with credentials set
DEMO_MODE=false

# --- Claude for drafting (falls back to the template when unset) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# or via OpenRouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Default sender (editable in the UI) ---
SENDER_NAME=Amar Kumar Dani
SENDER_COMPANY=AKD AI Solutions
SENDER_BOOKING_URL=

PORT=3000
